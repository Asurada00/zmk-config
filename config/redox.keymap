#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // --------------------------------------------------------------------------------------------------------------------------------
            // | ESC   |  1  |  2  |   3   |  4  |  5  |                   ---                |  6    |  7    |  8    |  9   | 0  |    BSPC   |
            // | TAB   |  Q  |  W  |   E   |  R  |  T  |   (   |           ---        |  )    |  Y    |  U    |  I    |  O   | P  |     -     |
            // | CTRL  |  A  |  S  |   D   |  F  |  G  |   [   |           ---        |  ]    |  H    |  J    |  K    |  L   | ;  |     '     |
            // | SHIFT |  Z  |  X  |   C   |  V  |  B  | PG_UP | PG_DOWN | --- | HOME | END   |  N    |  M    |  ,    |  .   | /  | SHFT(RET) |
            // | CRTL  | ALT | GUI | LOWER |    GUI    | LOWER | SPACE   | --- | DEL  | SPACE |     RAISE     | LEFT  | DOWN | UP |   RIGHT   |

            bindings = <
&kp ESC        &kp N1    &kp N2            &kp N3             &kp N4  &kp N5                                                                           &kp N6  &kp N7             &kp N8         &kp N9          &kp N0          &kp BSPC
&kp TAB        &kp Q     &kp W             &kp E              &kp R   &kp T   &kp GRAVE                                          &kp MINUS             &kp Y   &kp U              &kp I          &kp O           &kp P           &kp DELETE
&kp BACKSPACE  &kp A     &kp S             &kp D              &kp F   &kp G   &kp KP_ENTER                                       &kp EQUAL             &kp H   &kp J              &kp K          &kp L           &kp SEMI        &kp ENTER
&kp LSHFT      &kp Z     &kp X             &kp C              &kp V   &kp B   &kp LEFT_SHIFT  &kp LEFT_ALT        &kp RIGHT_ALT  &kp RS(LEFT_CONTROL)  &kp N   &kp M              &kp COMMA      &kp DOT         &kp UP_ARROW    &kp RSHFT
&kp LCTRL      &kp LALT  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &mo 1           &kp SPACE       &kp LEFT_CONTROL    &kp BACKSPACE  &kp RIGHT_CONTROL             &kp RIGHT_CONTROL  &kp BACKSLASH  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT
            >;
        };

        layer_1 {
            bindings = <
&trans        &kp F1   &kp F2          &kp F3              &kp F4           &kp F5                                                 &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &trans
&kp CAPSLOCK  &kp F6   &kp F7          &kp F8              &kp F9           &kp F10              &trans                    &trans  &trans  &trans  &trans  &trans  &trans   &trans
&trans        &kp F11  &kp LEFT_ARROW  &kp UP_ARROW        &kp RIGHT_ARROW  &kp PRINTSCREEN      &to 2                     &trans  &trans  &trans  &trans  &trans  &trans   &trans
&trans        &kp F12  &trans          &kp DOWN_ARROW      &trans           &kp LA(PRINTSCREEN)  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans
&trans        &trans   &kp LEFT_GUI    &kp K_CONTEXT_MENU  &trans                                &trans  &trans    &trans  &trans          &trans  &trans  &trans  &trans   &trans
            >;
        };

        layer_2 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp Q   &kp W   &kp E   &kp R   &trans                    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp A   &kp W   &kp D   &kp F   &kp T                     &to 0   &trans  &trans  &trans  &trans  &trans  &to 0
&trans  &trans  &kp Z   &kp X   &kp D   &kp V   &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &kp B           &trans  &trans    &trans  &trans          &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
