#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // --------------------------------------------------------------------------------------------------------------------------------
            // | ESC   |  1  |  2  |   3   |  4  |  5  |                   ---                |  6    |  7    |  8    |  9   | 0  |    BSPC   |
            // | TAB   |  Q  |  W  |   E   |  R  |  T  |   (   |           ---        |  )    |  Y    |  U    |  I    |  O   | P  |     -     |
            // | CTRL  |  A  |  S  |   D   |  F  |  G  |   [   |           ---        |  ]    |  H    |  J    |  K    |  L   | ;  |     '     |
            // | SHIFT |  Z  |  X  |   C   |  V  |  B  | PG_UP | PG_DOWN | --- | HOME | END   |  N    |  M    |  ,    |  .   | /  | SHFT(RET) |
            // | CRTL  | ALT | GUI | LOWER |    GUI    | LOWER | SPACE   | --- | DEL  | SPACE |     RAISE     | LEFT  | DOWN | UP |   RIGHT   |

            bindings = <
&kp ESC         &kp BACKSLASH  &kp N2            &kp N3             &kp N4  &kp N5                                                                &kp N6  &kp N7  &kp N8        &kp N9          &kp DELETE     &kp BACKSPACE
&kp CAPSLOCK    &kp NUMBER_1   &kp W             &kp E              &kp R   &kp T   &kp GRAVE                                      &kp MINUS      &kp Y   &kp U   &kp I         &kp O           &kp N0         &kp BACKSPACE
&kp TAB         &kp Q          &kp S             &kp D              &kp F   &kp G   &kp KP_ENTER                                   &kp EQUAL      &kp H   &kp J   &kp K         &kp L           &kp P          &kp ENTER
&kp DELETE      &kp A          &kp X             &kp C              &kp V   &kp B   &kp LEFT_SHIFT  &kp LEFT_ALT        &kp SQT    &kp BACKSPACE  &kp N   &kp M   &kp COMMA     &kp DOT         &kp SEMICOLON  &kp RSHFT
&kp LEFT_SHIFT  &kp Z          &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &mo 1           &kp SPACE       &kp LEFT_CONTROL    &kp SLASH  &kp RIGHT_ALT          &mo 1   &kp UP_ARROW  &kp DOWN_ARROW  &kp LEFT       &kp RIGHT
            >;
        };

        layer_1 {
            bindings = <
&trans  &trans         &kp F2          &kp F3          &kp F4           &kp F5                                                     &kp F6         &kp F7    &kp F8          &kp F9     &trans         &kp C_PLAY_PAUSE
&trans  &kp F1         &trans          &trans          &trans           &trans               &kp F11                    &kp F12    &trans         &trans    &trans          &trans     &kp F10        &kp C_MUTE
&trans  &kp PG_UP      &kp LEFT_ARROW  &kp UP_ARROW    &kp RIGHT_ARROW  &kp PRINTSCREEN      &to 2                      &to 2      &kp PG_UP      &kp LEFT  &kp UP_ARROW    &kp RIGHT  &kp PG_UP      &kp C_VOLUME_UP
&trans  &kp PAGE_DOWN  &kp HOME        &kp DOWN_ARROW  &kp END          &kp LA(PRINTSCREEN)  &trans   &trans    &trans  &trans     &kp PAGE_DOWN  &kp HOME  &kp DOWN_ARROW  &kp END    &kp PAGE_DOWN  &kp C_VOLUME_DOWN
&trans  &kp LCTRL      &kp LEFT_ALT    &kp LEFT_GUI    &trans                                &trans   &trans    &trans  &kp RCTRL                 &trans    &trans          &trans     &kp HOME       &kp END
            >;
        };

        layer_2 {
            bindings = <
&trans     &kp NUMBER_1    &trans  &trans  &trans  &trans                                    &trans  &trans  &trans  &trans  &trans  &trans
&trans     &kp TAB         &kp Q   &kp X   &kp E   &kp R   &trans                    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&kp PG_UP  &kp LEFT_SHIFT  &kp A   &kp W   &kp D   &kp F   &kp T                     &to 0   &trans  &trans  &trans  &trans  &trans  &to 0
&kp PG_DN  &kp LEFT_SHIFT  &kp Z   &kp S   &kp C   &kp V   &kp G   &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&kp P      &kp LCTRL       &trans  &trans  &kp B           &trans  &trans    &trans  &trans          &to 0   &trans  &trans  &trans  &trans
            >;
        };

        layer_3 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans    &trans  &trans          &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
